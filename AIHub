<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>IdeaSpark - Idea Generator</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background: linear-gradient(135deg, #667eea, #764ba2);
    }

    .app {
      width: 100%;
      max-width: 700px;
      background: white;
      border-radius: 25px;
      padding: 35px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    .logo {
      font-size: 50px;
      margin-bottom: 10px;
    }

    h1 {
      color: #333;
      font-size: 34px;
    }

    .subtitle {
      color: #777;
      margin-top: 8px;
      margin-bottom: 25px;
    }

    .categories {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-bottom: 25px;
    }

    .category {
      padding: 10px 18px;
      border: 2px solid #ddd;
      border-radius: 25px;
      background: white;
      cursor: pointer;
      font-weight: bold;
      color: #555;
    }

    .category:hover {
      border-color: #667eea;
      color: #667eea;
    }

    .category.active {
      background: #667eea;
      color: white;
      border-color: #667eea;
    }

    .idea-card {
      background: linear-gradient(135deg, #f5f7ff, #eee9ff);
      border-radius: 20px;
      padding: 30px;
      min-height: 220px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-bottom: 20px;
    }

    #ideaIcon {
      font-size: 50px;
      margin-bottom: 15px;
    }

    #ideaTitle {
      font-size: 25px;
      color: #333;
      margin-bottom: 12px;
    }

    #ideaDescription {
      color: #666;
      line-height: 1.6;
      font-size: 16px;
    }

    .generate {
      border: none;
      background: #667eea;
      color: white;
      padding: 15px 35px;
      border-radius: 30px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      margin: 8px;
    }

    .generate:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(102,126,234,0.35);
    }

    .save {
      border: 2px solid #667eea;
      background: white;
      color: #667eea;
      padding: 13px 30px;
      border-radius: 30px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      margin: 8px;
    }

    .saved-section {
      margin-top: 30px;
      text-align: left;
      display: none;
    }

    .saved-section h2 {
      color: #333;
      margin-bottom: 12px;
    }

    .saved-item {
      background: #f5f5f5;
      padding: 12px 15px;
      border-radius: 10px;
      margin-bottom: 8px;
      color: #555;
    }

    @media (max-width: 600px) {

      .app {
        padding: 25px 18px;
      }

      h1 {
        font-size: 28px;
      }

      .idea-card {
        padding: 25px 18px;
      }

      #ideaTitle {
        font-size: 21px;
      }

    }
  </style>
</head>

<body>

  <div class="app">

    <div class="logo">💡</div>

    <h1>IdeaSpark</h1>

    <p class="subtitle">
      Generate your next great idea ✨
    </p>


    <div class="categories">

      <button class="category active" data-category="business">
        💰 Business
      </button>

      <button class="category" data-category="website">
        🌐 Website
      </button>

      <button class="category" data-category="game">
        🎮 Game
      </button>

      <button class="category" data-category="content">
        📱 Content
      </button>

    </div>


    <div class="idea-card">

      <div id="ideaIcon">💡</div>

      <h2 id="ideaTitle">
        Click Generate Idea
      </h2>

      <p id="ideaDescription">
        Choose a category and discover a new idea.
      </p>

    </div>


    <button class="generate" onclick="generateIdea()">
      ✨ Generate Idea
    </button>

    <button class="save" onclick="saveIdea()">
      ❤️ Save Idea
    </button>


    <div class="saved-section" id="savedSection">

      <h2>❤️ Saved Ideas</h2>

      <div id="savedIdeas"></div>

    </div>

  </div>


  <script>

    const ideas = {

      business: [

        {
          icon: "👗",
          title: "Custom Fashion Studio",
          description:
            "Create a small online service where customers can request custom dress designs and receive digital sketches."
        },

        {
          icon: "🎁",
          title: "Personalized Gift Shop",
          description:
            "Sell customized digital and physical gifts for birthdays, weddings and special occasions."
        },

        {
          icon: "📚",
          title: "Student Notes Service",
          description:
            "Create clean and attractive digital notes, study planners and printable resources for students."
        },

        {
          icon: "🎨",
          title: "Social Media Design Service",
          description:
            "Offer affordable Instagram posts, posters and promotional designs for small businesses."
        }

      ],


      website: [

        {
          icon: "💡",
          title: "Daily Idea Generator",
          description:
            "A website that gives users random business, content, website and project ideas."
        },

        {
          icon: "📅",
          title: "Student Planner",
          description:
            "A simple website where students can organize assignments, exams and daily study tasks."
        },

        {
          icon: "💰",
          title: "Expense Tracker",
          description:
            "A browser-based tool that helps users track income, expenses and savings."
        },

        {
          icon: "🎯",
          title: "Goal Tracker",
          description:
            "Users can create goals and track their daily progress with simple progress bars."
        }

      ],


      game: [

        {
          icon: "⭐",
          title: "Catch the Star",
          description:
            "Players must click falling stars before they disappear. The fastest player gets the highest score."
        },

        {
          icon: "🧠",
          title: "Memory Match",
          description:
            "Flip cards and find matching pairs before the timer runs out."
        },

        {
          icon: "🐍",
          title: "Mini Snake",
          description:
            "Control a snake, collect food and try to achieve the highest score without hitting the wall."
        },

        {
          icon: "🚀",
          title: "Space Dodge",
          description:
            "Control a spaceship and avoid incoming asteroids for as long as possible."
        }

      ],


      content: [

        {
          icon: "🎨",
          title: "Design Tips Series",
          description:
            "Create short videos teaching one simple graphic design tip every day."
        },

        {
          icon: "👗",
          title: "Fashion Transformation",
          description:
            "Create before-and-after fashion styling videos showing how an outfit can be transformed."
        },

        {
          icon: "💻",
          title: "Website Building Series",
          description:
            "Create short tutorials showing how simple websites are built using HTML, CSS and JavaScript."
        },

        {
          icon: "✨",
          title: "Daily Motivation",
          description:
            "Create short motivational videos with original quotes, animations and simple visuals."
        }

      ]

    };


    let selectedCategory = "business";

    let currentIdea = null;


    const categoryButtons =
      document.querySelectorAll(".category");


    categoryButtons.forEach(button => {

      button.addEventListener("click", function() {

        categoryButtons.forEach(btn =>
          btn.classList.remove("active")
        );

        this.classList.add("active");

        selectedCategory =
          this.dataset.category;

      });

    });


    function generateIdea() {

      const list =
        ideas[selectedCategory];

      const randomIndex =
        Math.floor(Math.random() * list.length);

      currentIdea = list[randomIndex];

      document.getElementById("ideaIcon")
        .textContent = currentIdea.icon;

      document.getElementById("ideaTitle")
        .textContent = currentIdea.title;

      document.getElementById("ideaDescription")
        .textContent = currentIdea.description;

    }


    function saveIdea() {

      if (!currentIdea) {

        alert("Generate an idea first! 💡");

        return;
      }

      let saved =
        JSON.parse(
          localStorage.getItem("savedIdeas")
        ) || [];

      const alreadySaved =
        saved.some(
          idea => idea.title === currentIdea.title
        );

      if (!alreadySaved) {

        saved.push(currentIdea);

        localStorage.setItem(
          "savedIdeas",
          JSON.stringify(saved)
        );

        displaySavedIdeas();

        alert("Idea saved! ❤️");

      } else {

        alert("This idea is already saved!");

      }

    }


    function displaySavedIdeas() {

      const saved =
        JSON.parse(
          localStorage.getItem("savedIdeas")
        ) || [];

      const section =
        document.getElementById("savedSection");

      const container =
        document.getElementById("savedIdeas");

      if (saved.length === 0) {

        section.style.display = "none";

        return;
      }

      section.style.display = "block";

      container.innerHTML = "";

      saved.forEach(idea => {

        const item =
          document.createElement("div");

        item.className = "saved-item";

        item.textContent =
          idea.icon + " " + idea.title;

        container.appendChild(item);

      });

    }


    displaySavedIdeas();

  </script>

</body>
</html>
