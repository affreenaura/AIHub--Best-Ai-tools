extends Control

var age := 21
var month := 1
var salary := 30000
var money := 10000
var savings := 0
var career_level := 1

var food := 5000
var rent := 7000
var transport := 2000
var entertainment := 2000

var title_label: Label
var stats_label: Label
var event_label: Label
var result_label: Label


func _ready():
	create_game_ui()
	update_screen()


func create_game_ui():
	# Background
	var background = ColorRect.new()
	background.color = Color("#101522")
	background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(background)

	# Main container
	var container = VBoxContainer.new()
	container.position = Vector2(60, 40)
	container.size = Vector2(900, 650)
	add_child(container)

	# Title
	title_label = Label.new()
	title_label.text = "ADULTING"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override("font_size", 42)
	container.add_child(title_label)

	var subtitle = Label.new()
	subtitle.text = "Earn • Spend • Save • Build Your Life"
	subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	subtitle.add_theme_font_size_override("font_size", 20)
	container.add_child(subtitle)

	# Stats
	stats_label = Label.new()
	stats_label.add_theme_font_size_override("font_size", 20)
	container.add_child(stats_label)

	# Event
	event_label = Label.new()
	event_label.text = "Your first month starts now!"
	event_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	event_label.add_theme_font_size_override("font_size", 18)
	container.add_child(event_label)

	# Buttons
	var salary_button = Button.new()
	salary_button.text = "💼 Receive Salary"
	salary_button.custom_minimum_size = Vector2(0, 55)
	salary_button.pressed.connect(receive_salary)
	container.add_child(salary_button)

	var expense_button = Button.new()
	expense_button.text = "🧾 Pay Monthly Expenses"
	expense_button.custom_minimum_size = Vector2(0, 55)
	expense_button.pressed.connect(pay_expenses)
	container.add_child(expense_button)

	var save_button = Button.new()
	save_button.text = "💰 Save ₹5,000"
	save_button.custom_minimum_size = Vector2(0, 55)
	save_button.pressed.connect(save_money)
	container.add_child(save_button)

	var invest_button = Button.new()
	invest_button.text = "📈 Invest ₹2,000"
	invest_button.custom_minimum_size = Vector2(0, 55)
	invest_button.pressed.connect(invest_money)
	container.add_child(invest_button)

	var next_button = Button.new()
	next_button.text = "➡️ Next Month"
	next_button.custom_minimum_size = Vector2(0, 55)
	next_button.pressed.connect(next_month)
	container.add_child(next_button)

	# Result
	result_label = Label.new()
	result_label.add_theme_font_size_override("font_size", 22)
	container.add_child(result_label)


func update_screen():
	stats_label.text = (
		"👤 Age: %d\n" +
		"📅 Month: %d\n" +
		"💼 Career Level: %d\n" +
		"💵 Salary: ₹%d\n" +
		"💰 Cash: ₹%d\n" +
		"🏦 Savings: ₹%d"
	) % [age, month, career_level, salary, money, savings]


func receive_salary():
	money += salary
	event_label.text = "💼 Salary received!\n₹%d has been added to your cash." % salary
	result_label.text = "Good start! Now decide how to use your money."
	update_screen()


func pay_expenses():
	var total_expenses = food + rent + transport + entertainment

	if money >= total_expenses:
		money -= total_expenses
		event_label.text = (
			"🧾 Monthly expenses paid!\n" +
			"Food: ₹%d\nRent: ₹%d\nTransport: ₹%d\nEntertainment: ₹%d"
		) % [food, rent, transport, entertainment]
		result_label.text = "₹%d spent this month." % total_expenses
	else:
		event_label.text = "⚠️ Not enough money to pay all expenses!"
		result_label.text = "You need to manage your money better."


func save_money():
	if money >= 5000:
		money -= 5000
		savings += 5000
		event_label.text = "💰 ₹5,000 added to your savings!"
		result_label.text = "Savings are growing!"
	else:
		event_label.text = "⚠️ You don't have ₹5,000 available."
		result_label.text = "Try earning more or reducing expenses."

	update_screen()


func invest_money():
	if money >= 2000:
		money -= 2000
		savings += 2000
		event_label.text = "📈 ₹2,000 invested!"
		result_label.text = "Your investment will help your future."
	else:
		event_label.text = "⚠️ Not enough money to invest."
		result_label.text = "Build your cash first."

	update_screen()


func next_month():
	month += 1

	# Every 12 months = one year
	if month % 12 == 1:
		age += 1
		career_level += 1
		salary += 5000

		event_label.text = (
			"🎉 Congratulations!\n" +
			"You received a promotion!\n" +
			"New salary: ₹%d"
		) % salary
	else:
		random_life_event()

	update_screen()


func random_life_event():
	var events = [
		"🎁 You received a ₹3,000 bonus!",
		"📱 Your phone needs a ₹2,000 repair.",
		"🎓 You spent ₹1,500 on a new skill course.",
		"🚗 Transport costs increased this month.",
		"😊 You had a peaceful month with no major expenses."
	]

	var event = events[randi() % events.size()]
	event_label.text = event

	if event == events[0]:
		money += 3000
	elif event == events[1]:
		if money >= 2000:
			money -= 2000
	elif event == events[2]:
		if money >= 1500:
			money -= 1500
	elif event == events[3]:
		if money >= 1000:
			money -= 1000


func _process(_delta):
	update_screen()
