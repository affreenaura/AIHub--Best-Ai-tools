<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Catch the Star ⭐</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
    }

    .game-container {
      width: 95%;
      max-width: 700px;
      text-align: center;
    }

    h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .subtitle {
      margin-bottom: 20px;
      opacity: 0.9;
    }

    .info {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 15px;
    }

    .box {
      background: rgba(255,255,255,0.18);
      padding: 12px 20px;
      border-radius: 12px;
      flex: 1;
      backdrop-filter: blur(8px);
    }

    .box span {
      display: block;
      font-size: 13px;
      opacity: 0.8;
    }

    .box strong {
      font-size: 25px;
    }

    #gameArea {
      position: relative;
      width: 100%;
      height: 450px;
      background: rgba(255,255,255,0.12);
      border: 2px solid rgba(255,255,255,0.4);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    #star {
      position: absolute;
      display: none;
      font-size: 55px;
      cursor: pointer;
      user-select: none;
      transition: transform 0.1s;
    }

    #star:hover {
      transform: scale(1.15);
    }

    #message {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 24px;
      font-weight: bold;
      width: 90%;
    }

    button {
      margin-top: 20px;
      padding: 14px 35px;
      border: none;
      border-radius: 30px;
      background: white;
      color: #5b4bb7;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    button:hover {
      transform: translateY(-2px);
    }

    .result {
      margin-top: 15px;
      font-size: 18px;
      font-weight: bold;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 30px;
      }

      #gameArea {
        height: 400px;
      }

      .box {
        padding: 10px;
      }

      .box strong {
        font-size: 20px;
      }

      #star {
        font-size: 45px;
      }
    }
  </style>
</head>

<body>

  <div class="game-container">

    <h1>⭐ Catch the Star</h1>

    <p class="subtitle">
      Click the star as fast as you can!
    </p>

    <div class="info">

      <div class="box">
        <span>Score</span>
        <strong id="score">0</strong>
      </div>

      <div class="box">
        <span>Time</span>
        <strong id="time">30</strong>
      </div>

      <div class="box">
        <span>Best</span>
        <strong id="best">0</strong>
      </div>

    </div>

    <div id="gameArea">

      <div id="message">
        Press Start Game to begin 🎮
      </div>

      <div id="star">
        ⭐
      </div>

    </div>

    <button id="startButton">
      Start Game
    </button>

    <div class="result" id="result"></div>

  </div>


  <script>

    const gameArea = document.getElementById("gameArea");
    const star = document.getElementById("star");
    const scoreDisplay = document.getElementById("score");
    const timeDisplay = document.getElementById("time");
    const bestDisplay = document.getElementById("best");
    const startButton = document.getElementById("startButton");
    const message = document.getElementById("message");
    const result = document.getElementById("result");

    let score = 0;
    let timeLeft = 30;
    let gameRunning = false;
    let timer;

    let bestScore = localStorage.getItem("bestScore") || 0;

    bestDisplay.textContent = bestScore;


    function moveStar() {

      const areaWidth = gameArea.clientWidth;
      const areaHeight = gameArea.clientHeight;

      const starSize = 60;

      const randomX =
        Math.random() * (areaWidth - starSize);

      const randomY =
        Math.random() * (areaHeight - starSize);

      star.style.left = randomX + "px";
      star.style.top = randomY + "px";
    }


    function startGame() {

      score = 0;
      timeLeft = 30;
      gameRunning = true;

      scoreDisplay.textContent = score;
      timeDisplay.textContent = timeLeft;

      message.style.display = "none";
      result.textContent = "";

      star.style.display = "block";

      startButton.textContent = "Restart Game";

      moveStar();

      clearInterval(timer);

      timer = setInterval(function() {

        timeLeft--;

        timeDisplay.textContent = timeLeft;

        if (timeLeft <= 0) {

          endGame();

        }

      }, 1000);
    }


    function endGame() {

      gameRunning = false;

      clearInterval(timer);

      star.style.display = "none";

      message.style.display = "block";

      message.innerHTML =
        "⏰ Time's Up!<br>Your Score: " + score;

      if (score > bestScore) {

        bestScore = score;

        localStorage.setItem(
          "bestScore",
          bestScore
        );

        bestDisplay.textContent = bestScore;

        result.textContent =
          "🏆 New High Score!";

      } else {

        result.textContent =
          "Great job! Try to beat your best score.";

      }

    }


    star.addEventListener("click", function() {

      if (!gameRunning) return;

      score++;

      scoreDisplay.textContent = score;

      moveStar();

    });


    startButton.addEventListener("click", function() {

      startGame();

    });

  </script>

</body>
</html>
